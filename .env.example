# Copia este archivo a .env y completa tus valores. NUNCA subas .env al repo.
GROQ_API_KEY=pega_aqui_tu_api_key_de_groq
GROQ_MODEL=openai/gpt-oss-20b
# gpt-oss es un modelo de razonamiento: usar low para respuestas rápidas
REASONING_EFFORT=low
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Techo explícito de tokens de salida (OWASP LLM10)
MAX_TOKENS=500
UPSTREAM_TIMEOUT_S=30

# false = línea base vulnerable | true = escudo activo (se usa desde F2 en adelante)
PROTECTION_ENABLED=false
RATE_LIMIT=5/minute

API_HOST=127.0.0.1
API_PORT=8000
